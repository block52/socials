# Subreddit to monitor (default: poker)
SUBREDDIT=poker

# Poll interval in seconds (default: 30)
POLL_INTERVAL_SECONDS=30

# Number of posts to fetch per poll (default: 25)
POST_LIMIT=25

# Optional: Custom user agent
USER_AGENT=RedditPokerBot/1.0

# Optional: Discord webhook URL for posting new posts
# Get yours from Discord Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=
