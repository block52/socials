# Reddit API Credentials
# Get these from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Optional: Custom user agent (recommended to identify your bot)
REDDIT_USER_AGENT=RedditPokerBot/1.0 by u/your_username

# Subreddit to monitor (default: poker)
REDDIT_SUBREDDIT=poker

# Poll interval in seconds (default: 30)
# Note: Reddit rate limits to ~60 requests/minute for OAuth apps
POLL_INTERVAL_SECONDS=30

# Number of posts to fetch per poll (default: 25)
POST_LIMIT=25
