# Subreddit(s) to monitor (comma-separated, default: poker)
# Examples: poker, poker,Poker_Theory, poker,Poker_Theory,chipporn
SUBREDDIT=poker,Poker_Theory

# Poll interval in seconds (default: 30)
POLL_INTERVAL_SECONDS=30

# Number of posts to fetch per poll (default: 25)
POST_LIMIT=25

# Optional: Custom user agent
USER_AGENT=RedditPokerBot/1.0

# Optional: Discord webhook URL for posting new posts
# Get yours from Discord Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Optional: Anthropic API key for Claude AI response generation
# Get yours from https://console.anthropic.com/
# When enabled, Claude will generate 3 response suggestions for each post
ANTHROPIC_API_KEY=
